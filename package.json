{
  "name": "new-frontier-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site officiel du serveur RedM New Frontier RP",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "db:migrate": "tsx --conditions=react-server scripts/setup.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "admin:reset": "tsx --conditions=react-server scripts/admin-reset.ts",
    "setup:prod": "tsx --env-file=.env.vercel --conditions=react-server scripts/setup.ts",
    "admin:create:prod": "tsx --env-file=.env.vercel --conditions=react-server scripts/admin-create.ts",
    "import:gitbook": "tsx scripts/import-gitbook.ts",
    "pentest": "node scripts/pentest.mjs",
    "audit:deps": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@node-rs/argon2": "2.2.2",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "marked": "18.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
