# Copiez ce fichier en .env.local ; `npm run setup` génère automatiquement les secrets.

# --- Base de données ---
# Local / VPS : fichier SQLite.  Vercel : URL Turso (libsql://...) + jeton.
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=

# --- Origine publique exacte du site, sans / final ---
APP_ORIGIN=http://localhost:3000

# --- Secrets (32 octets aléatoires en base64). JAMAIS dans Git. ---
SESSION_SECRET=
PASSWORD_PEPPER=
ENCRYPTION_KEY=

# --- En-tête d'IP fiable posé par VOTRE reverse-proxy ---
# Vercel : x-vercel-forwarded-for   |   Cloudflare : cf-connecting-ip   |   Nginx/Caddy : x-real-ip
# Obligatoire en production : le serveur refuse de démarrer sans. Vide uniquement en développement.
# Le port de Node ne doit pas être joignable sans passer par ce proxy, sinon l'en-tête est forgeable.
TRUSTED_IP_HEADER=

# --- Double authentification obligatoire pour accéder au panel (true par défaut en production) ---
REQUIRE_2FA=true
